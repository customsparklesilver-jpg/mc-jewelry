@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

/* Tokens
   NOTE: Hydrogen uses `text-primary` for text and `bg-contrast` for backgrounds,
   so for a dark theme primary = cream text, contrast = #0a0a0a background. */
:root {
  --color-primary: 255 243 220; /* warm cream text */
  --color-contrast: 10 10 10; /* #0a0a0a background */
  --color-accent: 201 168 76; /* gold #C9A84C */
  --color-gold: #c9a84c;
  --color-gold-soft: rgb(201 168 76 / 0.35);
  --color-card: #141414;
  --color-shop-pay: #5a31f4;
  --font-display: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
  --radius-card: 16px;
  --font-size-fine: 0.75rem;
  --font-size-copy: 1rem;
  --font-size-lead: 1.125rem;
  --font-size-heading: 2rem;
  --font-size-display: 3rem;
  --color-sale: 191 72 0;
  --shop-pay-button-width: 100%;
  --height-nav: 3rem;
  --screen-height: 100vh;
  --screen-height-dynamic: 100vh;

  @media (min-width: 32em) {
    --height-nav: 4rem;
  }
  @media (min-width: 48em) {
    --height-nav: 6rem;
    --font-size-heading: 2.25rem; /* text-4xl */
    --font-size-display: 3.75rem; /* text-6xl */
  }
  @supports (height: 100svh) {
    --screen-height: 100svh;
  }
  @supports (height: 100dvh) {
    --screen-height-dynamic: 100dvh;
  }
}

/* The old prefers-color-scheme: dark block was removed: it switched the
   palette to light text/orange accent and would fight the always-dark theme. */

@keyframes fadeInAnimation {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

shop-pay-button {
  width: 100%;
  height: 3rem;
  display: table;
}

@layer base {
  * {
    font-variant-ligatures: none;
  }

  html {
    scroll-padding-top: 10rem;
    background-color: #0a0a0a;
  }

  body {
    @apply border-primary/10 bg-contrast text-primary/90 antialiased;
    background-color: #0a0a0a;
    font-family: var(--font-display);
    font-size: 1.125rem; /* Cormorant runs small; bump base size slightly */
    letter-spacing: 0.01em;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  ::selection {
    background: #c9a84c;
    color: #0a0a0a;
  }

  a {
    transition: color 200ms ease, border-color 200ms ease;
  }

  a:hover {
    color: #c9a84c;
  }

  model-viewer::part(default-progress-mask) {
    display: none;
  }

  model-viewer::part(default-progress-bar) {
    display: none;
  }

  input[type='search']::-webkit-search-decoration,
  input[type='search']::-webkit-search-cancel-button,
  input[type='search']::-webkit-search-results-button,
  input[type='search']::-webkit-search-results-decoration {
    -webkit-appearance: none;
  }

  a.active {
    @apply border-b;
    border-color: #c9a84c;
  }

  .prose {
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
      &:first-child {
        @apply mt-0;
      }
    }
  }
}

@layer components {
  .article {
    h2,
    h3,
    h4,
    h5,
    h6 {
      @apply text-primary;
      font-family: var(--font-display);
    }
    @apply prose mx-auto mb-12 grid justify-center text-primary;
    font-family: var(--font-display);
    p,
    ul,
    li {
      @apply mb-4 text-lg;
    }
    img {
      @apply md:-mx-8 lg:-mx-16;
      border-radius: var(--radius-card);

      @media (min-width: 48em) {
        width: calc(100% + 4rem);
        max-width: 100vw;
      }
      @media (min-width: 64em) {
        width: calc(100% + 8rem);
      }
    }
  }

  .swimlane {
    @apply grid w-full snap-x snap-mandatory scroll-px-6 grid-flow-col justify-start gap-4 overflow-x-scroll px-6 pb-4;
  }

  /* Rounded, dark cards with gold hover accent */
  .card {
    background: var(--color-card);
    border: 1px solid rgb(201 168 76 / 0.15);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: border-color 300ms ease, box-shadow 300ms ease,
      transform 300ms ease;
  }

  .card:hover {
    border-color: var(--color-gold);
    box-shadow: 0 8px 30px rgb(201 168 76 / 0.15);
    transform: translateY(-2px);
  }
}

@layer utilities {
  .fadeIn {
    opacity: 0;
    animation: fadeInAnimation ease 500ms forwards;
  }

  .hiddenScroll {
    scrollbar-width: none;
    &::-webkit-scrollbar {
      display: none;
    }
  }

  .absolute-center {
    @apply absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2;
  }

  .strike {
    position: relative;
    &::before {
      content: '';
      display: block;
      position: absolute;
      width: 108%;
      height: 1.5px;
      left: -4%;
      top: 50%;
      transform: translateY(-50%);
      background: rgb(var(--color-primary));
      box-shadow: 0.5px 0.5px 0px 0.5px rgb(var(--color-contrast));
    }
  }

  .card-image {
    @apply relative flex items-center justify-center overflow-clip;
    border-radius: var(--radius-card);
    background: var(--color-card);
    transition: box-shadow 400ms ease;

    &::before {
      content: ' ';
      @apply absolute top-0 left-0 z-10 block h-full w-full shadow-border;
      border-radius: var(--radius-card);
      pointer-events: none;
      transition: box-shadow 400ms ease;
    }

    img {
      @apply aspect-[inherit] w-full object-cover;
      transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1),
        filter 400ms ease;
    }

    /* Hover: slow zoom, slight brighten, gold glow ring */
    &:hover {
      box-shadow: 0 10px 40px rgb(201 168 76 / 0.22);
    }
    &:hover::before {
      box-shadow: inset 0 0 0 1px #c9a84c;
    }
    &:hover img {
      transform: scale(1.07);
      filter: brightness(1.08) contrast(1.03);
    }
  }

  /* Any product image inside a link/card gets the same hover treatment */
  .product-image-hover {
    overflow: hidden;
    border-radius: var(--radius-card);
    img {
      transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    &:hover img {
      transform: scale(1.07);
    }
  }

  .text-gold {
    color: #c9a84c;
  }
  .border-gold {
    border-color: #c9a84c;
  }
  .bg-gold {
    background-color: #c9a84c;
    color: #0a0a0a;
  }
}

@media (prefers-reduced-motion: reduce) {
  .card,
  .card-image,
  .card-image img,
  .product-image-hover img {
    transition: none;
  }
  .card:hover,
  .card-image:hover img,
  .product-image-hover:hover img {
    transform: none;
  }

